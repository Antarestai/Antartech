<script is:inline>
    // --- Tabs de Filtrado Rápido ---
    const tabButtons = document.querySelectorAll('.sw-tab-btn');
    const sections = document.querySelectorAll('.sw-section');

    function setActiveTab(targetTab) {
        tabButtons.forEach(btn => {
            const isTarget = btn.getAttribute('data-tab') === targetTab;
            if (isTarget) {
                btn.className = 'sw-tab-btn px-4 py-2.5 rounded-xl text-xs font-black uppercase tracking-wider transition-all duration-300 bg-gray-900 text-white dark:bg-white dark:text-gray-900 shadow-md cursor-pointer';
            } else {
                btn.className = 'sw-tab-btn px-4 py-2.5 rounded-xl text-xs font-black uppercase tracking-wider transition-all duration-300 bg-white/70 dark:bg-white/[0.04] text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white border border-gray-200/80 dark:border-white/[0.08] cursor-pointer';
            }
        });

        sections.forEach(sec => {
            const cat = sec.getAttribute('data-category');
            if (targetTab === 'all' || cat === targetTab) {
                sec.style.display = 'block';
            } else {
                sec.style.display = 'none';
            }
        });
    }

    tabButtons.forEach(btn => {
        btn.addEventListener('click', () => {
            const tab = btn.getAttribute('data-tab') || 'all';
            setActiveTab(tab);
        });
    });

    if (window.location.hash) {
        const hash = window.location.hash.replace('#', '');
        if (hash === 'via-qmk' || hash === 'qmk') setActiveTab('qmk');
        else if (hash === 'dxtweak') setActiveTab('dxtweak');
        else if (hash === 'simhub') setActiveTab('simhub');
    }

    // Scroll reveal
    const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add('revealed');
            }
        });
    }, { threshold: 0.1 });
    document.querySelectorAll('.scroll-reveal').forEach(el => observer.observe(el));
</script>

<style>
    .scroll-reveal { opacity: 0; transform: translateY(40px); transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), transform 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
    .scroll-reveal.revealed { opacity: 1; transform: translateY(0); }
</style>
