---
import Layout from '../../layouts/Layout.astro';
import InstructionModal from '../../components/InstructionModal.astro';
import Reviews from '../../components/Reviews.astro';
import { getCollection, render } from 'astro:content'; 
import { Image } from 'astro:assets';

export async function getStaticPaths() {
  const devices = await getCollection('devices');
  return devices.map(device => ({
    params: { id: device.id },
    props: { device },
  }));
}

const { device } = Astro.props;
const { Content } = await render(device);
const gallery = device.data.gallery || (device.data.image ? [device.data.image] : []);
const instructionSteps = device.data.instructionSteps || [];

// Buscamos si hay prev/next links
const devices = await getCollection('devices');
const currentIndex = devices.findIndex(d => d.id === device.id);
const prevDevice = currentIndex > 0 ? devices[currentIndex - 1] : null;
const nextDevice = currentIndex < devices.length - 1 ? devices[currentIndex + 1] : null;

const formatter = new Intl.NumberFormat('es-AR', {
    style: 'currency',
    currency: 'ARS',
    maximumFractionDigits: 0
});

const waMessage = `Hola, me comunico para comprar un ${device.data.title} que vi por la pagina`;
const waLinkDynamic = `https://wa.me/541165361612?text=${encodeURIComponent(waMessage)}`;
const waCustomMessage = `Hola, me interesa personalizar un ${device.data.title}. ¿Qué opciones hay?`;
const waCustomLink = `https://wa.me/541165361612?text=${encodeURIComponent(waCustomMessage)}`;

function getYoutubeEmbedUrl(url: string | undefined): string | null {
    if (!url) return null;
    const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
    const match = url.match(regExp);
    if (!match || match[2].length !== 11) return null;
    const id = match[2];
    const timeMatch = url.match(/[?&]t=(\d+)s?/);
    const start = timeMatch ? `?start=${timeMatch[1]}` : '';
    return `https://www.youtube-nocookie.com/embed/${id}${start}`;
}
const videoEmbedUrl = getYoutubeEmbedUrl(device.data.videoGuideUrl);
const profilesList = device.data.profiles || [];
const stockToAvailability: Record<string, string> = {
    'En Stock': 'https://schema.org/InStock',
    'A Pedido': 'https://schema.org/PreOrder',
    'Sold Out': 'https://schema.org/OutOfStock',
    'Próximamente': 'https://schema.org/PreOrder',
};

const productJsonLd = {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": device.data.title,
    "description": device.data.description,
    "image": device.data.image ? new URL(device.data.image, Astro.site).href : undefined,
    "brand": {
        "@type": "Brand",
        "name": "Antares Tech"
    },
    ...(device.data.price ? {
        "offers": {
            "@type": "Offer",
            "price": device.data.price,
            "priceCurrency": "ARS",
            "availability": stockToAvailability[device.data.stock || 'En Stock'] || 'https://schema.org/InStock',
            "url": new URL(`/devices/${device.id}`, Astro.site).href,
            "seller": {
                "@type": "Organization",
                "name": "Antares Tech by AlmaMia3D"
            }
        }
    } : {})
};
---

<Layout title={`${device.data.title} - Setup & Config | Antares Tech`} description={device.data.description}>
    <script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />
    <div class="fixed inset-0 -z-10 overflow-hidden pointer-events-none bg-[#d5d0c8] dark:bg-[#030014] transition-colors duration-700">
        <div 
            class="absolute inset-0 opacity-[0.25] dark:opacity-[0.7] transition-opacity duration-700" 
            style="background: 
                linear-gradient(135deg, var(--pcb-line) 2px, transparent 2px),
                linear-gradient(225deg, var(--pcb-line) 2px, transparent 2px),
                radial-gradient(var(--pcb-pad) 4px, transparent 4px);
                background-size: 60px 60px, 60px 60px, 60px 60px;
                background-position: 0 0, 30px 0, 30px 30px;
                background-color: var(--pcb-bg);"
        ></div>
        <div class="absolute inset-0 bg-gradient-to-b from-[#d5d0c8]/40 via-[#d5d0c8]/80 to-[#d5d0c8] dark:from-transparent dark:via-[#030014]/80 dark:to-[#030014] transition-colors duration-700"></div>
        <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(circle at 85% 15%, rgba(99,102,241,0.12), transparent 50%), radial-gradient(circle at 15% 85%, rgba(6,182,212,0.12), transparent 50%);"></div>
        

        <div class="absolute inset-0 z-[1] pointer-events-none overflow-hidden hidden md:block opacity-30 dark:opacity-40">

            <svg class="absolute top-[15%] left-[5%] w-48 h-48 text-indigo-500/10 dark:text-indigo-400/10 animate-float-slow transform -rotate-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.5">
                <rect x="4" y="4" width="16" height="16" rx="2" ry="2"/>
                <rect x="9" y="9" width="6" height="6"/>
                <line x1="9" y1="1" x2="9" y2="4"/>
                <line x1="15" y1="1" x2="15" y2="4"/>
                <line x1="9" y1="20" x2="9" y2="23"/>
                <line x1="15" y1="20" x2="15" y2="23"/>
                <line x1="20" y1="9" x2="23" y2="9"/>
                <line x1="20" y1="14" x2="23" y2="14"/>
                <line x1="1" y1="9" x2="4" y2="9"/>
                <line x1="1" y1="14" x2="4" y2="14"/>
                <circle cx="6" cy="6" r="0.5" fill="currentColor"/>
                <circle cx="18" cy="18" r="0.5" fill="currentColor"/>
            </svg>


            <svg class="absolute bottom-[20%] right-[5%] w-64 h-64 text-fuchsia-500/10 dark:text-fuchsia-400/10 animate-float-slow-reverse transform rotate-12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="0.5">
                <rect x="4" y="4" width="16" height="16" rx="2" ry="2"/>
                <rect x="9" y="9" width="6" height="6"/>
                <path d="M4 12h16M12 4v16"/>
                <circle cx="12" cy="12" r="2" fill="currentColor"/>
                <path d="M2.5 8h1.5M2.5 16h1.5M20 8h1.5M20 16h1.5M8 2.5v1.5M16 2.5v1.5M8 20v1.5M16 20v1.5"/>
            </svg>
            

            <svg class="absolute top-[40%] text-cyan-500/10 dark:text-cyan-400/10 animate-pulse w-full h-auto max-w-[800px] left-1/2 -translate-x-1/2" viewBox="0 0 100 20" fill="none" stroke="currentColor" stroke-width="0.2">
                <path d="M0 10h15l5-5h10l5 5h15l5-5h10l5 5h15"/>
                <path d="M0 15h20l5-5h15l5-5h10l5 5h15"/>
                <circle cx="15" cy="10" r="0.5" fill="currentColor"/>
                <circle cx="35" cy="5" r="0.5" fill="currentColor"/>
                <circle cx="65" cy="5" r="0.5" fill="currentColor"/>
                <circle cx="20" cy="15" r="0.5" fill="currentColor"/>
                <circle cx="45" cy="10" r="0.5" fill="currentColor"/>
            </svg>
        </div>
    </div>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-32 pb-24 min-h-screen relative z-10">
        
        <a href="/#store" class="inline-flex items-center text-[10px] font-black uppercase tracking-widest text-gray-500 dark:text-gray-400 hover:text-indigo-600 dark:hover:text-cyan-400 transition-all duration-300 mb-12 group/back">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="mr-2 group-hover/back:-translate-x-1 transition-transform duration-300"><path d="m15 18-6-6 6-6"/></svg>
            Volver a Productos
        </a>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
            

            <div class="lg:col-span-4 lg:sticky lg:top-32 scroll-reveal">
                <div class="flex flex-wrap gap-2 mb-6">
                    {/* Stock Badge */}
                    {device.data.stock && (
                        <span class={`
                            px-3 py-1.5 rounded-lg text-[10px] font-black uppercase tracking-widest border border-white/10
                            ${device.data.stock === 'En Stock' ? 'bg-green-500/10 text-green-700 dark:text-green-400 border-green-500/20' : ''}
                            ${device.data.stock === 'A Pedido' ? 'bg-yellow-500/10 text-yellow-700 dark:text-yellow-400 border-yellow-500/20' : ''}
                            ${device.data.stock === 'Sold Out' ? 'bg-red-500/10 text-red-700 dark:text-red-400 border-red-500/20' : ''}
                        `}>
                            <span class={`inline-block w-1.5 h-1.5 rounded-full mr-1 
                                ${device.data.stock === 'En Stock' ? 'bg-green-500 animate-[ping_3s_ease-in-out_infinite]' : ''}
                                ${device.data.stock === 'A Pedido' ? 'bg-yellow-500' : ''}
                                ${device.data.stock === 'Sold Out' ? 'bg-red-500' : ''}
                            `}></span>
                            {device.data.stock}
                        </span>
                    )}
                    
                    {device.data.tags && device.data.tags.map((tag: string) => (
                        <span class="text-[10px] font-black uppercase tracking-widest text-indigo-600 dark:text-cyan-400 bg-indigo-50 dark:bg-cyan-500/10 px-3 py-1.5 rounded-lg border border-indigo-200/50 dark:border-cyan-500/20">
                            {tag}
                        </span>
                    ))}
                </div>

                <h1 class="text-5xl lg:text-6xl font-black text-gray-900 dark:text-white mb-6 tracking-tighter leading-tight break-words">
                    {device.data.title}
                </h1>

                <p class="text-lg text-gray-600 dark:text-gray-400 font-light leading-relaxed mb-10">
                    {device.data.description}
                </p>

                <div class="flex flex-col gap-3">
                    {device.data.softwareUrl && (
                        <a href={device.data.softwareUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center bg-gradient-to-r from-blue-600 to-cyan-500 hover:from-blue-500 hover:to-cyan-400 text-white px-6 py-4.5 rounded-2xl font-black uppercase text-xs tracking-[0.1em] transition-all duration-500 shadow-xl shadow-cyan-500/25 w-full hover:-translate-y-1 hover:shadow-cyan-500/40">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="mr-2.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                            Descargar {device.data.softwareName || 'Software'}
                        </a>
                    )}

                    {device.data.firmwareUrl && device.data.firmwareUrl !== device.data.softwareUrl && (
                        <a href={device.data.firmwareUrl} download class="inline-flex items-center justify-center bg-gradient-to-r from-indigo-600 to-cyan-500 hover:from-indigo-500 hover:to-cyan-400 text-white px-6 py-4.5 rounded-2xl font-black uppercase text-xs tracking-[0.1em] transition-all duration-500 shadow-xl shadow-indigo-500/25 w-full hover:-translate-y-1 hover:shadow-indigo-500/40">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="mr-2.5" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                            {device.id === 'iflag' ? 'Descargar Perfiles iFlag (.zip)' : (device.data.firmwareUrl.endsWith('.zip') ? 'Descargar DXTweak2 (Calibración)' : 'Descargar Configuración (VIA)')}
                        </a>
                    )}

                    {videoEmbedUrl && (
                        <a href="#video-guide" class="inline-flex items-center justify-center bg-red-500/10 hover:bg-red-500/20 text-red-600 dark:text-red-400 border border-red-500/30 px-6 py-4 rounded-2xl font-black uppercase text-xs tracking-[0.1em] transition-all duration-300 w-full hover:-translate-y-0.5 group/yt">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="mr-2 group-hover/yt:scale-110 transition-transform"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/></svg>
                            Video Tutorial de Ayuda
                        </a>
                    )}

                    {instructionSteps.length > 0 && (
                        <button 
                            id="open-instructions-btn"
                            class="inline-flex items-center justify-center bg-white/50 dark:bg-white/[0.05] border border-indigo-200 dark:border-indigo-500/20 hover:bg-indigo-50 dark:hover:bg-indigo-500/10 text-indigo-600 dark:text-indigo-400 px-6 py-4.5 rounded-2xl font-black uppercase text-xs tracking-[0.1em] transition-all duration-500 w-full hover:-translate-y-1 hover:shadow-lg hover:shadow-indigo-500/15 group/instr cursor-pointer"
                        >
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="mr-2.5 group-hover/instr:scale-110 transition-transform duration-300" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
                            </svg>
                            Instrucciones
                        </button>
                    )}

                    <div class="mt-4 pt-4 border-t border-gray-100 dark:border-white/5 relative group/price overflow-hidden rounded-xl">
                        {device.data.price && (
                            <div class="flex items-center justify-between mb-4 px-2">
                                <span class="text-sm text-gray-500 dark:text-gray-400 font-medium">Precio Final</span>
                                <span class="text-xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-gray-700 to-gray-900 dark:from-gray-300 dark:to-white group-hover/price:from-indigo-500 group-hover/price:to-cyan-400 transition-all duration-500 cursor-default">
                                    {formatter.format(device.data.price)}
                                </span>
                            </div>
                        )}

                        <button 
                        class="add-to-cart-btn inline-flex items-center justify-center bg-white/50 dark:bg-white/[0.05] border border-gray-200 dark:border-white/10 hover:bg-gray-100 dark:hover:bg-white/10 text-gray-700 dark:text-gray-300 px-8 py-5 rounded-2xl font-black uppercase text-xs tracking-[0.1em] transition-all duration-300 w-full group/btn"
                        data-id={device.id}
                        data-title={device.data.title}
                        data-price={device.data.price || 45000} 
                        data-image={device.data.image ? typeof device.data.image === 'object' ? device.data.image.src : device.data.image : ''}
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="mr-3" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
                            <path d="M3 6h18"/>
                            <path d="M12 10v6"/>
                            <path d="M9 13h6"/>
                        </svg>
                        Añadir a mi pedido
                    </button>
                    </div>
                </div>
            </div>


            <div class="lg:col-span-8 w-full scroll-reveal" style="transition-delay: 150ms">

                {gallery.length > 0 && (
                    <div class="relative w-full h-72 md:h-[450px] mb-12 rounded-[2rem] overflow-hidden shadow-2xl shadow-indigo-500/10 dark:shadow-indigo-950/30 border border-white/50 dark:border-white/10 bg-gray-200 dark:bg-gray-900 group/gallery" id="gallery-container">

                        {gallery.map((img: string, idx: number) => (
                            <img 
                                src={img} 
                                alt={`${device.data.title} - foto ${idx + 1}`} 
                                class={`gallery-slide absolute inset-0 w-full h-full object-cover transition-all duration-700 ${idx === 0 ? 'opacity-100 scale-100' : 'opacity-0 scale-105'}`}
                                data-index={idx}
                                loading={idx === 0 ? "eager" : "lazy"}
                            />
                        ))}

                        <div class="absolute inset-0 bg-gradient-to-t from-black/30 via-transparent to-transparent pointer-events-none z-10"></div>
                        
                        {gallery.length > 1 && (
                            <>

                            <button id="gallery-prev" class="absolute left-4 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-full bg-white/90 dark:bg-black/70 border border-white/50 dark:border-white/10 flex items-center justify-center text-gray-700 dark:text-white hover:bg-white dark:hover:bg-black/90 transition-all duration-300 opacity-0 group-hover/gallery:opacity-100 hover:scale-110 shadow-lg">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                            </button>
                            <button id="gallery-next" class="absolute right-4 top-1/2 -translate-y-1/2 z-20 w-11 h-11 rounded-full bg-white/90 dark:bg-black/70 border border-white/50 dark:border-white/10 flex items-center justify-center text-gray-700 dark:text-white hover:bg-white dark:hover:bg-black/90 transition-all duration-300 opacity-0 group-hover/gallery:opacity-100 hover:scale-110 shadow-lg">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                            </button>

                            <div class="absolute bottom-4 left-1/2 -translate-x-1/2 z-20 flex items-center gap-2">
                                {gallery.map((_: string, idx: number) => (
                                    <button 
                                        class={`gallery-dot w-2.5 h-2.5 rounded-full transition-all duration-500 ${idx === 0 ? 'bg-white scale-110 shadow-md' : 'bg-white/40 hover:bg-white/70'}`}
                                        data-dot={idx}
                                    ></button>
                                ))}
                            </div>

                            <div class="absolute top-4 right-4 z-20 bg-black/60 text-white text-[10px] font-bold tracking-wider px-3 py-1.5 rounded-full border border-white/10">
                                <span id="gallery-counter">1</span> / {gallery.length}
                            </div>
                            </>
                        )}
                    </div>
                )}

                <article class="markdown-content bg-white dark:bg-[#0c0a1a] p-8 md:p-12 lg:p-16 rounded-[2rem] shadow-xl shadow-indigo-500/5 dark:shadow-indigo-950/30 border border-gray-200/80 dark:border-white/[0.08] ring-1 ring-white/20 dark:ring-white/[0.05] w-full overflow-hidden relative">
                    <Content />

                    {profilesList.length > 0 && (
                        <div class="mt-14 pt-12 border-t border-gray-200/80 dark:border-white/10" id="perfiles">
                            <div class="flex items-center gap-3 mb-6">
                                <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-500">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                                </div>
                                <div>
                                    <h3 class="text-2xl font-black text-gray-900 dark:text-white uppercase tracking-tight">Perfiles y Archivos de Configuración</h3>
                                    <p class="text-xs text-gray-500 dark:text-gray-400 font-light">Descargá e importá estos perfiles en SimHub con un solo clic.</p>
                                </div>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                {profilesList.map((prof: any) => (
                                    <div class="p-6 rounded-2xl bg-gray-50 dark:bg-white/[0.02] border border-gray-200/80 dark:border-white/[0.08] flex flex-col justify-between">
                                        <div>
                                            <div class="flex items-center justify-between mb-2">
                                                <h4 class="text-sm font-black text-gray-900 dark:text-white uppercase tracking-wider">{prof.name}</h4>
                                                <span class="text-[9px] font-bold uppercase tracking-widest px-2.5 py-1 rounded bg-cyan-500/10 text-cyan-600 dark:text-cyan-400 border border-cyan-500/20">{prof.tag || 'SimHub'}</span>
                                            </div>
                                            <p class="text-xs text-gray-500 dark:text-gray-400 font-light leading-relaxed mb-6">{prof.description}</p>
                                        </div>
                                        {prof.url ? (
                                            <a 
                                                href={prof.url} 
                                                download={prof.url.startsWith('/') ? true : undefined}
                                                target={prof.url.startsWith('http') ? '_blank' : undefined}
                                                rel={prof.url.startsWith('http') ? 'noopener noreferrer' : undefined}
                                                class="inline-flex items-center justify-center gap-2 w-full bg-gradient-to-r from-cyan-600 to-blue-600 hover:from-cyan-500 hover:to-blue-500 text-white py-3 rounded-xl font-bold uppercase text-xs tracking-wider transition-all duration-300 shadow-md shadow-cyan-500/20"
                                            >
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" x2="12" y1="15" y2="3"/></svg>
                                                {prof.url.includes('github') ? 'Descargar Plugin (GitHub)' : 'Descargar Archivo'}
                                            </a>
                                        ) : (
                                            <div class="flex items-center justify-center gap-2 py-3 rounded-xl bg-gray-200/50 dark:bg-white/[0.04] text-gray-500 dark:text-gray-400 text-xs font-semibold border border-gray-300/40 dark:border-white/5">
                                                <span class="w-1.5 h-1.5 rounded-full bg-yellow-500 animate-pulse"></span>
                                                Próximamente disponible para descargar
                                            </div>
                                        )}
                                    </div>
                                ))}
                            </div>
                        </div>
                    )}

                    {videoEmbedUrl && (
                        <div class="mt-14 pt-12 border-t border-gray-200/80 dark:border-white/10" id="video-guide">
                            <div class="flex items-center gap-3 mb-6">
                                <div class="w-10 h-10 rounded-xl bg-red-500/10 border border-red-500/20 flex items-center justify-center text-red-500">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M19.615 3.184c-3.604-.246-11.631-.245-15.23 0-3.897.266-4.356 2.62-4.385 8.816.029 6.185.484 8.549 4.385 8.816 3.6.245 11.626.246 15.23 0 3.897-.266 4.356-2.62 4.385-8.816-.029-6.185-.484-8.549-4.385-8.816zm-10.615 12.816v-8l8 3.993-8 4.007z"/></svg>
                                </div>
