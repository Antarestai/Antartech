---
// src/components/Reviews.astro
import { REVIEWS } from '../data/reviews';

interface Props {
  deviceId?: string;
  title?: string;
  subtitle?: string;
}

const { deviceId, title, subtitle } = Astro.props;

const reviewsToDisplay = deviceId 
  ? REVIEWS.filter(r => r.deviceId === deviceId)
  : REVIEWS;

// Counts by product for filter tabs
const handbrakeCount = REVIEWS.filter(r => r.deviceId === 'handbrake').length;
const antaknobCount = REVIEWS.filter(r => r.deviceId === 'antaknob').length;
const powerCount = REVIEWS.filter(r => r.deviceId === 'pc-power-button').length;

const mlPerfilLink = "https://listado.mercadolibre.com.ar/_CustId_119316055?item_id=MLA1996684374&category_id=MLA432881&seller_id=119316055&client=recoview-selleritems&recos_listing=true#origin=vip&component=sellerData&typeSeller=classic";
---

{reviewsToDisplay.length > 0 && (
<section id="opiniones" class="relative py-14 sm:py-16 bg-gray-50/50 dark:bg-[#040114] transition-colors duration-700 overflow-hidden border-t border-b border-gray-200/60 dark:border-white/5">
    <!-- Ambient subtle glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-yellow-400/5 dark:bg-yellow-500/[0.03] rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <!-- Section Header -->
        <div class="text-center max-w-3xl mx-auto mb-8 scroll-reveal">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-yellow-400/10 border border-yellow-400/30 text-yellow-600 dark:text-yellow-400 text-[10px] sm:text-[11px] font-black uppercase tracking-widest mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                    <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                </svg>
                <span>Reseñas de Compradores Reales</span>
            </div>

            <h2 class="text-3xl md:text-4xl lg:text-5xl font-black tracking-tight text-gray-900 dark:text-white uppercase mb-3">
                {title || 'Qué opinan quienes ya compraron'}
            </h2>

            <p class="text-sm md:text-base text-gray-600 dark:text-gray-400 font-light leading-relaxed max-w-2xl mx-auto">
                {subtitle || 'Valoraciones reales y transparentes de clientes en Mercado Libre. Calidad comprobada, mejoras continuas y fotos reales de cada setup.'}
            </p>

            <!-- Trust Badges Bar -->
            <div class="mt-6 flex flex-wrap items-center justify-center gap-4 sm:gap-6 text-xs font-semibold text-gray-600 dark:text-gray-300">
                <div class="flex items-center gap-1.5 text-yellow-500">
                    <div class="flex gap-0.5">
                        {Array.from({ length: 5 }).map(() => (
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
                                <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                            </svg>
                        ))}
                    </div>
                    <span class="font-bold text-gray-900 dark:text-white ml-1 text-xs">Calificaciones Reales</span>
                </div>
                <div class="hidden sm:block w-1 h-1 rounded-full bg-gray-300 dark:bg-gray-700"></div>
                <div class="flex items-center gap-1.5">
                    <img src="/images/mercadolibre.png" alt="Mercado Libre" class="w-4 h-4 object-contain" />
                    <span>Publicaciones Oficiales ML</span>
                </div>
                <div class="hidden sm:block w-1 h-1 rounded-full bg-gray-300 dark:bg-gray-700"></div>
                <div class="flex items-center gap-1.5 text-green-600 dark:text-green-400">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                        <path d="m9 12 2 2 4-4"/>
                    </svg>
                    <span>Compra Protegida</span>
                </div>
            </div>
        </div>

        {/* Product Filter Tabs (shown when viewing all reviews) */}
        {!deviceId && (
            <div class="flex flex-wrap items-center justify-center gap-2 mb-8 scroll-reveal">
                <button 
                    type="button" 
                    data-review-filter="all" 
                    class="review-filter-btn px-4 py-2 rounded-xl text-xs font-black uppercase tracking-wider transition-all duration-300 bg-gray-900 text-white dark:bg-white dark:text-gray-900 shadow-md shadow-indigo-500/10 cursor-pointer"
                >
                    Todas ({reviewsToDisplay.length})
                </button>
                <button 
                    type="button" 
                    data-review-filter="handbrake" 
                    class="review-filter-btn px-4 py-2 rounded-xl text-xs font-black uppercase tracking-wider transition-all duration-300 bg-gray-100 dark:bg-white/[0.04] text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white border border-gray-200/80 dark:border-white/[0.08] cursor-pointer"
                >
                    🏎️ Freno de Mano ({handbrakeCount})
                </button>
                <button 
                    type="button" 
                    data-review-filter="antaknob" 
                    class="review-filter-btn px-4 py-2 rounded-xl text-xs font-black uppercase tracking-wider transition-all duration-300 bg-gray-100 dark:bg-white/[0.04] text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white border border-gray-200/80 dark:border-white/[0.08] cursor-pointer"
                >
                    🎛️ AntaKnob ({antaknobCount})
                </button>
                <button 
                    type="button" 
                    data-review-filter="pc-power-button" 
                    class="review-filter-btn px-4 py-2 rounded-xl text-xs font-black uppercase tracking-wider transition-all duration-300 bg-gray-100 dark:bg-white/[0.04] text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white border border-gray-200/80 dark:border-white/[0.08] cursor-pointer"
                >
                    🔘 Switch PC ({powerCount})
                </button>
            </div>
        )}

        <!-- Reviews Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-5 scroll-reveal" id="reviews-grid">
            {reviewsToDisplay.map((review) => (
                <div 
                    class="review-card group relative flex flex-col justify-between p-4 sm:p-5 rounded-2xl bg-white dark:bg-[#0c091e] border border-gray-200/80 dark:border-white/[0.08] shadow-sm hover:border-yellow-400/50 dark:hover:border-yellow-400/40 hover:shadow-lg hover:shadow-yellow-500/10 transition-all duration-300"
                    data-device={review.deviceId}
                >
                    <div>
                        <!-- Header: Stars + Platform logo -->
                        <div class="flex items-center justify-between gap-2 mb-2.5">
                            <!-- Stars (Filled + Empty) -->
                            <div class="flex items-center gap-0.5">
                                {Array.from({ length: review.rating }).map(() => (
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-yellow-400 fill-current" viewBox="0 0 24 24">
                                        <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                                    </svg>
                                ))}
                                {Array.from({ length: 5 - review.rating }).map(() => (
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-gray-300 dark:text-gray-700 fill-current" viewBox="0 0 24 24">
                                        <path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/>
                                    </svg>
                                ))}
                            </div>

                            <!-- ML Badge -->
                            <div class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-yellow-400/15 border border-yellow-400/30 text-[9px] font-bold text-gray-800 dark:text-yellow-300 shrink-0">
                                <img src="/images/mercadolibre.png" alt="Mercado Libre" class="w-3 h-3 object-contain" />
                                <span>Mercado Libre</span>
                            </div>
                        </div>

                        <!-- Product Pill & Version Badge -->
                        <div class="flex flex-wrap items-center gap-1.5 mb-3">
                            <span class="inline-block text-[9px] font-black uppercase tracking-wider text-indigo-600 dark:text-cyan-400 bg-indigo-50 dark:bg-cyan-950/60 border border-indigo-100 dark:border-cyan-800/40 px-2 py-0.5 rounded-md">
                                {review.productName}
                            </span>
                            {review.versionBadge && (
                                <span class="inline-flex items-center gap-1 text-[8px] font-bold uppercase tracking-wider text-amber-700 dark:text-amber-400 bg-amber-50 dark:bg-amber-950/60 border border-amber-200 dark:border-amber-800/50 px-1.5 py-0.5 rounded-md">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-2.5 h-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                                    {review.versionBadge}
                                </span>
                            )}
                        </div>

                        <!-- Comment -->
                        <blockquote class="text-xs sm:text-[13px] text-gray-800 dark:text-gray-200 font-medium leading-relaxed mb-3.5 italic">
                            “{review.comment}”
                        </blockquote>

                        <!-- Buyer setup photo (if available) -->
                        {review.image && (
                            <div class="mb-3.5 overflow-hidden rounded-xl border border-gray-200 dark:border-white/10 bg-black/5 dark:bg-black/40 group/img relative">
                                <img 
                                    src={review.image} 
                                    alt={`Foto de setup enviada por comprador - ${review.productName}`}
                                    class="w-full h-32 sm:h-36 object-cover object-center transform transition-transform duration-500 group-hover/img:scale-105"
                                    loading="lazy"
                                />
                                <div class="absolute bottom-1.5 left-1.5 px-1.5 py-0.5 rounded bg-black/75 backdrop-blur-sm text-[8px] font-bold uppercase tracking-wider text-white/90 flex items-center gap-1">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-2.5 h-2.5 text-yellow-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
                                    Setup real
                                </div>
                            </div>
                        )}

                        <!-- Developer evolution & clarification response note -->
                        {review.developerNote && (
                            <div class="mb-3 p-3 rounded-xl bg-indigo-50/90 dark:bg-indigo-950/40 border border-indigo-200 dark:border-cyan-500/30 text-xs">
                                <div class="flex items-center gap-1.5 mb-1.5 text-indigo-700 dark:text-cyan-400 font-black uppercase tracking-wider text-[9px]">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><polyline points="9 12 11 14 15 10"/></svg>
                                    <span>{review.developerNote.title}</span>
                                </div>
                                <p class="text-gray-700 dark:text-gray-300 font-normal leading-relaxed text-[10px] sm:text-[11px]">
                                    {review.developerNote.text}
                                </p>
                            </div>
                        )}
                    </div>

                    <!-- Footer: Verified Author & Date -->
                    <div class="pt-3 border-t border-gray-100 dark:border-white/5 flex items-center justify-between text-[11px] text-gray-500 dark:text-gray-400 mt-1">
                        <div class="flex items-center gap-1.5">
                            <div class="w-5 h-5 rounded-full bg-green-500/15 text-green-600 dark:text-green-400 flex items-center justify-center font-bold text-[9px]">
                                <svg xmlns="http://www.w3.org/2000/svg" class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                                    <polyline points="20 6 9 17 4 12"/>
                                </svg>
                            </div>
                            <span class="font-bold text-gray-800 dark:text-gray-200 text-[11px]">{review.author}</span>
                        </div>
                        <span class="text-[10px] text-gray-400 dark:text-gray-500">{review.date}</span>
                    </div>

                </div>
            ))}
        </div>

        <!-- CTA footer linking to official Mercado Libre profile -->
        <div class="mt-12 text-center scroll-reveal">
            <a 
                href={mlPerfilLink} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-flex items-center gap-3 px-6 py-3.5 rounded-2xl bg-white dark:bg-white/5 border border-gray-200 dark:border-white/10 hover:border-yellow-400/60 dark:hover:border-yellow-400/40 text-gray-800 dark:text-white hover:text-yellow-600 dark:hover:text-yellow-400 text-xs font-black uppercase tracking-widest transition-all duration-300 shadow-sm hover:shadow-lg hover:shadow-yellow-500/10 group"
            >
                <img src="/images/mercadolibre.png" alt="Mercado Libre" class="w-4 h-4 object-contain group-hover:scale-110 transition-transform" />
                <span>Ver todas las opiniones en Mercado Libre</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="5" y1="12" x2="19" y2="12"></line>
                    <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
            </a>
        </div>
    </div>
</section>
)}

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const filterButtons = document.querySelectorAll('.review-filter-btn');
        const reviewCards = document.querySelectorAll('.review-card');

        if (filterButtons.length > 0) {
            filterButtons.forEach(btn => {
                btn.addEventListener('click', () => {
                    const filter = btn.getAttribute('data-review-filter') || 'all';

                    // Update active button styles
                    filterButtons.forEach(b => {
                        if (b.getAttribute('data-review-filter') === filter) {
                            b.classList.add('bg-gray-900', 'text-white', 'dark:bg-white', 'dark:text-gray-900', 'shadow-md');
                            b.classList.remove('bg-gray-100', 'dark:bg-white/[0.04]', 'text-gray-600', 'dark:text-gray-400', 'border', 'border-gray-200/80', 'dark:border-white/[0.08]');
                        } else {
                            b.classList.remove('bg-gray-900', 'text-white', 'dark:bg-white', 'dark:text-gray-900', 'shadow-md');
                            b.classList.add('bg-gray-100', 'dark:bg-white/[0.04]', 'text-gray-600', 'dark:text-gray-400', 'border', 'border-gray-200/80', 'dark:border-white/[0.08]');
                        }
                    });

                    // Filter review cards
                    reviewCards.forEach((card: any) => {
                        const device = card.getAttribute('data-device');
                        if (filter === 'all' || device === filter) {
                            card.style.display = 'flex';
                        } else {
                            card.style.display = 'none';
                        }
                    });
                });
            });
        }
    });
</script>