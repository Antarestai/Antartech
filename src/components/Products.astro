---
// src/components/Products.astro
import { Image } from 'astro:assets';

const { featuredDevices } = Astro.props;

const formatter = new Intl.NumberFormat('es-AR', {
    style: 'currency',
    currency: 'ARS',
    maximumFractionDigits: 0
});
---

<section id="store" class="py-24 bg-white dark:bg-[#030014] transition-colors duration-700 relative z-20 overflow-hidden">
    <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-indigo-500/50 to-transparent"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-12 px-4 scroll-reveal">
            <div class="flex items-center">
                <h2 class="text-3xl font-black text-gray-900 dark:text-white mr-6 uppercase tracking-tighter">Productos / Proyectos</h2>
                <div class="h-px bg-gradient-to-r from-indigo-500/50 to-transparent w-24 hidden lg:block"></div>
            </div>

            <!-- Filtros de Categoría -->
            <div class="flex flex-wrap items-center gap-2" id="category-filters">
                <button 
                    type="button" 
                    data-filter="all" 
                    class="category-filter-btn px-5 py-2.5 rounded-2xl text-xs font-black uppercase tracking-wider transition-all duration-300 bg-gray-900 text-white dark:bg-white dark:text-gray-900 shadow-md shadow-indigo-500/10 cursor-pointer"
                >
                    Todos
                </button>
                <button 
                    type="button" 
                    data-filter="simracing" 
                    class="category-filter-btn px-5 py-2.5 rounded-2xl text-xs font-black uppercase tracking-wider transition-all duration-300 bg-gray-100 dark:bg-white/[0.04] text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white border border-gray-200/80 dark:border-white/[0.08] cursor-pointer"
                >
                    🏎️ SimRacing
                </button>
                <button 
                    type="button" 
                    data-filter="logitech" 
                    class="category-filter-btn px-5 py-2.5 rounded-2xl text-xs font-black uppercase tracking-wider transition-all duration-300 bg-gray-100 dark:bg-white/[0.04] text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white border border-gray-200/80 dark:border-white/[0.08] cursor-pointer"
                >
                    🎮 Accesorios Logitech
                </button>
                <button 
                    type="button" 
                    data-filter="productividad" 
                    class="category-filter-btn px-5 py-2.5 rounded-2xl text-xs font-black uppercase tracking-wider transition-all duration-300 bg-gray-100 dark:bg-white/[0.04] text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white border border-gray-200/80 dark:border-white/[0.08] cursor-pointer"
                >
                    ⌨️ Productividad & Control
                </button>
            </div>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-10 px-4" id="products-grid">
            {featuredDevices.map((device: any, index: number) => {
                const deviceCats = [
                    device.data.category?.toLowerCase() || '',
                    ...(device.data.tags || []).map((t: string) => t.toLowerCase()),
                    device.id.toLowerCase()
                ].join(' ');

                return (
                <div 
                    class={`product-card group relative bg-white dark:bg-[#0e0c1e] border border-gray-200/80 dark:border-white/[0.08] rounded-[2.5rem] overflow-hidden shadow-lg dark:shadow-indigo-950/50 md:shadow-xl md:shadow-indigo-500/5 md:dark:shadow-2xl transition-colors duration-300 md:transition-all md:duration-700 md:hover:-translate-y-4 md:hover:shadow-2xl md:hover:shadow-indigo-500/25 md:hover:border-indigo-400/60 md:dark:hover:border-indigo-400/30 flex flex-col scroll-reveal ${device.data.isAccessory ? 'is-accessory hidden' : ''}`} 
                    style={`transition-delay: ${index * 75}ms`}
                    data-category={deviceCats}
                    data-is-accessory={device.data.isAccessory ? "true" : "false"}
                >
                    <div class="hidden md:block absolute inset-0 -translate-x-full group-hover:translate-x-full bg-gradient-to-r from-transparent via-white/40 dark:via-white/10 to-transparent transition-transform duration-[1.5s] ease-in-out pointer-events-none z-20"></div>

                    <div class="h-80 overflow-hidden relative z-10 bg-gray-100 dark:bg-gray-900/50">
                        {device.data.image ? (
                            <Image src={device.data.image as any} alt={device.data.title} width={800} height={600} format="webp" class="w-full h-full object-cover transform transition-transform duration-1000 group-hover:scale-110 will-change-transform" />
                        ) : (
                            <div class="w-full h-full flex items-center justify-center text-7xl bg-gray-200 dark:bg-gray-800">🛠️</div>
                        )}
                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
                        
                        {/* Stock Badge */}
                        {device.data.stock && (
                            <div class="absolute top-4 right-4 z-30">
                                <span class={`
                                    px-3 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest shadow-lg border outline outline-1 outline-white/10
                                    ${device.data.stock === 'En Stock' ? 'bg-green-500/20 text-green-700 dark:text-green-400 border-green-500/30' : ''}
                                    ${device.data.stock === 'A Pedido' ? 'bg-yellow-500/20 text-yellow-700 dark:text-yellow-400 border-yellow-500/30' : ''}
                                    ${device.data.stock === 'Sold Out' ? 'bg-red-500/20 text-red-700 dark:text-red-400 border-red-500/30' : ''}
                                    ${device.data.stock === 'Próximamente' ? 'bg-purple-500/20 text-purple-700 dark:text-purple-400 border-purple-500/30' : ''}
                                `}>
                                    <span class={`inline-block w-1.5 h-1.5 rounded-full mr-1 
                                        ${device.data.stock === 'En Stock' ? 'bg-green-500 animate-pulse' : ''}
                                        ${device.data.stock === 'A Pedido' ? 'bg-yellow-500' : ''}
                                        ${device.data.stock === 'Sold Out' ? 'bg-red-500' : ''}
                                        ${device.data.stock === 'Próximamente' ? 'bg-purple-500 animate-pulse' : ''}
                                    `}></span>
                                    {device.data.stock}
                                </span>
                            </div>
                        )}
                    </div>

                    <div class="p-10 flex flex-col flex-grow relative z-10">
                        <div class="flex flex-wrap gap-2 mb-4">
                            {device.data.category && (
                                <span class="text-[9px] font-black uppercase tracking-widest text-cyan-700 dark:text-cyan-300 bg-cyan-100/90 dark:bg-cyan-950/80 px-3 py-1.5 rounded-md border border-cyan-300 dark:border-cyan-700/60 shadow-sm flex items-center gap-1.5">
                                    <span class="w-1.5 h-1.5 rounded-full bg-cyan-500 animate-pulse"></span>
                                    {device.data.category}
                                </span>
                            )}
                            {device.data.tags && device.data.tags.map((tag: string) => (
                                <span class="text-[9px] font-black uppercase tracking-widest text-indigo-600 dark:text-cyan-400 bg-indigo-100/80 dark:bg-cyan-950/60 px-3 py-1.5 rounded-md border border-indigo-200 dark:border-cyan-800/50 shadow-sm">{tag}</span>
                            ))}
                        </div>
                        <h3 class="text-3xl font-black text-gray-900 dark:text-white mb-3 uppercase tracking-tighter leading-tight font-sans text-ellipsis overflow-hidden group-hover:text-indigo-600 dark:group-hover:text-cyan-400 transition-colors duration-500">{device.data.title}</h3>
                        <p class="text-gray-600 dark:text-gray-400 text-base mb-10 leading-relaxed font-light line-clamp-3">{device.data.description}</p>
                        
                        <div class="mt-auto flex items-center gap-4">
                            {device.data.stock === 'Próximamente' ? (
                                <div class="flex-grow flex justify-center items-center bg-gray-200/50 dark:bg-white/[0.05] text-gray-500 dark:text-gray-600 py-4.5 rounded-2xl font-black uppercase text-xs tracking-[0.1em] border border-gray-300/50 dark:border-white/5 cursor-not-allowed">
                                    En Desarrollo
                                </div>
                            ) : (
                                <>
                                    <a href={`/devices/${device.id}`} class="flex-grow flex justify-center items-center bg-gray-900 dark:bg-white text-white dark:text-gray-900 py-4.5 rounded-2xl font-black uppercase text-xs tracking-[0.1em] transition-all duration-500 hover:bg-gradient-to-r hover:from-fuchsia-600 hover:to-indigo-600 dark:hover:from-fuchsia-500 dark:hover:to-cyan-500 dark:hover:text-white shadow-lg hover:shadow-indigo-500/30">Setup & Config</a>
                                    <button 
                                        class="add-to-cart-btn flex items-center justify-center w-14 h-14 bg-gradient-to-tr from-indigo-600 via-indigo-500 to-cyan-500 text-white rounded-2xl shadow-lg shadow-indigo-500/25 hover:shadow-xl hover:shadow-indigo-500/40 hover:scale-105 active:scale-95 border border-white/25 dark:border-white/10 transition-all duration-300 shrink-0 group/cart cursor-pointer"
                                        data-id={device.id}
                                        data-title={device.data.title}
                                        data-price={device.data.price || 45000} 
                                        data-image={device.data.image ? typeof device.data.image === 'object' ? device.data.image.src : device.data.image : ''}
                                        aria-label={`Añadir ${device.data.title} al carrito`}
                                        title="Añadir al carrito"
                                    >
                                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" class="group-hover/cart:scale-110 transition-transform duration-300 drop-shadow-sm" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
                                            <path d="M3 6h18"/>
                                            <path d="M12 10v6"/>
                                            <path d="M9 13h6"/>
                                        </svg>
                                    </button>
                                </>
                            )}
                        </div>
                    </div>
                </div>
                );
            })}

            <!-- Tarjeta Ecosistema / Accesorios Logitech G -->
            <div 
                id="logitech-hub-card"
                class="product-card group relative bg-white dark:bg-[#0e0c1e] border-2 border-cyan-500/40 hover:border-cyan-400 dark:border-cyan-500/30 dark:hover:border-cyan-400 rounded-[2.5rem] overflow-hidden shadow-lg shadow-cyan-500/10 dark:shadow-cyan-950/40 transition-all duration-700 hover:-translate-y-4 hover:shadow-2xl hover:shadow-cyan-500/20 flex flex-col scroll-reveal cursor-pointer"
                data-category="all simracing"
            >
                <div class="h-80 relative overflow-hidden bg-gradient-to-b from-cyan-950/30 via-slate-900 to-slate-950 flex items-center justify-center p-8">
                    <div class="absolute inset-0 bg-[radial-gradient(#06b6d4_1px,transparent_1px)] [background-size:16px_16px] opacity-25"></div>
                    <div class="absolute inset-0 bg-gradient-to-t from-white dark:from-[#0e0c1e] via-transparent to-transparent"></div>

                    <!-- Hub Emblem -->
                    <div class="relative z-10 flex flex-col items-center text-center space-y-3">
                        <div class="w-24 h-24 rounded-3xl bg-cyan-500/10 border border-cyan-400/40 flex items-center justify-center shadow-xl shadow-cyan-500/20 group-hover:scale-110 group-hover:border-cyan-300 transition-transform duration-500">
                            <span class="text-5xl font-black text-transparent bg-clip-text bg-gradient-to-br from-cyan-300 via-blue-400 to-indigo-400 font-mono tracking-tighter">G</span>
                        </div>
                        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-cyan-500/20 border border-cyan-400/30 text-[10px] font-black uppercase tracking-widest text-cyan-300">
                            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
                            Ecosistema Logitech G
                        </div>
                    </div>

                    <!-- Badge compatible models -->
                    <div class="absolute top-4 right-4 z-20">
                        <span class="px-3 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest bg-cyan-500/10 text-cyan-300 border border-cyan-400/30">
                            G29 · G920 · G923
                        </span>
                    </div>
                </div>

                <div class="p-10 flex flex-col flex-grow relative z-10">
                    <div class="flex flex-wrap gap-2 mb-4">
                        <span class="text-[9px] font-black uppercase tracking-widest text-cyan-700 dark:text-cyan-300 bg-cyan-100/90 dark:bg-cyan-950/80 px-3 py-1.5 rounded-md border border-cyan-300 dark:border-cyan-700/60 shadow-sm">
                            Accesorios & Mods
                        </span>
                        <span class="text-[9px] font-black uppercase tracking-widest text-indigo-600 dark:text-cyan-400 bg-indigo-100/80 dark:bg-cyan-950/60 px-3 py-1.5 rounded-md border border-indigo-200 dark:border-cyan-800/50 shadow-sm">
                            SimRacing
                        </span>
                    </div>

                    <h3 class="text-3xl font-black text-gray-900 dark:text-white mb-3 uppercase tracking-tighter leading-tight font-sans group-hover:text-cyan-500 dark:group-hover:text-cyan-400 transition-colors duration-500">
                        Accesorios para Logitech
                    </h3>
                    <p class="text-gray-600 dark:text-gray-400 text-base mb-8 leading-relaxed font-light">
                        Interfaces independientes de 12 bits, adaptadores USB y mods de alto rendimiento diseñados específicamente para volantes y pedaleras Logitech.
                    </p>

                    <div class="mt-auto pt-5 border-t border-gray-100 dark:border-white/5 flex items-center justify-between">
                        <span class="text-xs font-black uppercase tracking-wider text-cyan-600 dark:text-cyan-400">Ver accesorios compatibles</span>
                        <div class="w-11 h-11 rounded-2xl bg-cyan-500/10 group-hover:bg-cyan-500 text-cyan-600 dark:text-cyan-400 group-hover:text-white dark:group-hover:text-gray-900 flex items-center justify-center transition-all duration-300 transform group-hover:translate-x-1 shadow-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                        </div>
                    </div>
                </div>
            </div>

            {/* Tarjeta de Próximamente / General Teaser */}
            <div 
                class={`product-card group relative bg-indigo-50/50 dark:bg-[#0e0c1e] md:bg-gradient-to-br md:from-indigo-500/5 md:to-fuchsia-500/5 md:dark:from-indigo-500/10 md:dark:to-fuchsia-500/10 border-2 border-dashed border-indigo-200 dark:border-white/10 rounded-[2.5rem] overflow-hidden transition-colors duration-300 md:transition-all md:duration-700 md:hover:-translate-y-4 md:hover:border-indigo-400/50 flex flex-col scroll-reveal`} 
                style={`transition-delay: ${featuredDevices.length * 75}ms`}
                data-category="all productividad setup"
            >
                <div class="h-80 flex items-center justify-center bg-gray-50/50 dark:bg-white/[0.02] relative overflow-hidden group">
                    <div class="absolute inset-0 bg-gradient-to-br from-indigo-500/10 via-transparent to-fuchsia-500/10 opacity-0 group-hover:opacity-100 transition-opacity duration-1000"></div>
                    <div class="relative z-10 text-center space-y-4">
                        <div class="w-20 h-20 mx-auto rounded-3xl bg-white dark:bg-white/10 shadow-xl shadow-indigo-500/10 flex items-center justify-center transform group-hover:rotate-12 transition-transform duration-500">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-10 h-10 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 3v18M3 12h18"/>
                            </svg>
                        </div>
                        <p class="text-xs font-black uppercase tracking-[0.2em] text-indigo-500 dark:text-indigo-400">Próximamente</p>
                    </div>
                </div>
                <div class="p-10 flex flex-col flex-grow text-center">
                    <h3 class="text-3xl font-black text-gray-900 dark:text-white mb-3 uppercase tracking-tighter leading-tight font-sans">Nuevos Proyectos</h3>
                    <p class="text-gray-600 dark:text-gray-400 text-base mb-10 leading-relaxed font-light">Estamos diseñando el futuro de tu setup. Nuevos periféricos custom están en camino.</p>
                    <div class="mt-auto">
                        <a href="/#contact" class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-widest text-indigo-600 dark:text-cyan-400 group/link">
                            Sugerir una idea
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transform group-hover/link:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import { cartStore } from '../scripts/cartStore.js';

    document.addEventListener('DOMContentLoaded', () => {
        // Lógica de Filtrado por Categoría
        const filterButtons = document.querySelectorAll('.category-filter-btn');
        const productCards = document.querySelectorAll('.product-card');
        const logitechHubCard = document.getElementById('logitech-hub-card');

        function setCategoryFilter(filter: string) {
            filterButtons.forEach(b => {
                const btnFilter = b.getAttribute('data-filter');
                if (btnFilter === filter) {
                    b.classList.add('active', 'bg-gray-900', 'text-white', 'dark:bg-white', 'dark:text-gray-900', 'shadow-md');
                    b.classList.remove('bg-gray-100', 'dark:bg-white/[0.04]', 'text-gray-600', 'dark:text-gray-400', 'border', 'border-gray-200/80', 'dark:border-white/[0.08]');
                } else {
                    b.classList.remove('active', 'bg-gray-900', 'text-white', 'dark:bg-white', 'dark:text-gray-900', 'shadow-md');
                    b.classList.add('bg-gray-100', 'dark:bg-white/[0.04]', 'text-gray-600', 'dark:text-gray-400', 'border', 'border-gray-200/80', 'dark:border-white/[0.08]');
                }
            });

            productCards.forEach((card: any) => {
                if (card.id === 'logitech-hub-card') {
                    // La tarjeta de colección Logitech se muestra en "Todos" o "SimRacing", y se oculta cuando se entra a "Accesorios Logitech" o "Productividad"
                    if (filter === 'all' || filter === 'simracing') {
                        card.style.display = 'flex';
                    } else {
                        card.style.display = 'none';
                    }
                    return;
                }

                const isAccessory = card.dataset.isAccessory === 'true';
                const cats = (card.dataset.category || '').toLowerCase();

                if (filter === 'all') {
                    // En "Todos", los accesorios individuales están agrupados bajo la tarjeta Hub
                    if (isAccessory) {
                        card.style.display = 'none';
                    } else {
                        card.style.display = 'flex';
                    }
                } else if (filter === 'logitech') {
                    // Al seleccionar Logitech, se revelan los accesorios para Logitech
                    if (cats.includes('logitech')) {
                        card.style.display = 'flex';
                    } else {
                        card.style.display = 'none';
                    }
                } else {
                    // Filtro por otra categoría (simracing, productividad)
                    if (cats.includes(filter)) {
                        card.style.display = 'flex';
                    } else {
                        card.style.display = 'none';
                    }
                }
            });
        }

        filterButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                const filter = btn.getAttribute('data-filter') || 'all';
                setCategoryFilter(filter);
            });
        });

        // Click en la tarjeta Hub activa el filtro de accesorios Logitech
        if (logitechHubCard) {
            logitechHubCard.addEventListener('click', () => {
                setCategoryFilter('logitech');
                const storeEl = document.getElementById('store');
                if (storeEl) {
                    storeEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        }

        // Lógica para Añadir al Carrito
        const addButtons = document.querySelectorAll('.add-to-cart-btn');
        
        addButtons.forEach(btn => {
            btn.addEventListener('click', (e) => {
                const button = e.currentTarget as HTMLElement;
                const id = button.dataset.id;
                const title = button.dataset.title;
                const price = parseFloat(button.dataset.price || '0');
                const image = button.dataset.image;

                if (id && title) {
                    // Animación de feedback local en el botón
                    const originalHTML = button.innerHTML;
                    button.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="animate-bounce"><polyline points="20 6 9 17 4 12"></polyline></svg>`;
                    button.classList.add('bg-green-500', 'text-white', 'border-green-500');
                    button.classList.remove('text-indigo-600');
                    
                    setTimeout(() => {
                        button.innerHTML = originalHTML;
                        button.classList.remove('bg-green-500', 'text-white', 'border-green-500');
                        button.classList.add('text-indigo-600');
                    }, 1000);

                    // Guardar en store
                    cartStore.addItem({ id, title, price, image });
                    
                    // Abrir Drawer para darle feedback visual al usuario de que entró al carrito
                    window.dispatchEvent(new CustomEvent('antares_open_cart'));
                }
            });
        });
    });
</script>
