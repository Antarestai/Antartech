---
// src/components/test/MakerQuote.astro
---

<section class="py-20 bg-gray-50/50 dark:bg-[#040114] transition-colors duration-700 relative z-20 overflow-hidden border-t border-gray-200/50 dark:border-white/5">
    <!-- Ambient glow -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[350px] bg-indigo-500/5 dark:bg-fuchsia-500/5 rounded-full blur-3xl pointer-events-none"></div>

    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="relative p-8 sm:p-12 md:p-16 rounded-[2.5rem] bg-white dark:bg-[#0c091e] border border-gray-200/80 dark:border-white/[0.08] shadow-xl dark:shadow-indigo-950/30 scroll-reveal">
            
            <!-- Quotation Mark Icon -->
            <div class="absolute top-6 right-8 sm:top-10 sm:right-12 text-indigo-500/10 dark:text-cyan-400/10 select-none pointer-events-none">
                <svg width="80" height="80" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z"/>
                </svg>
            </div>

            <!-- Pre-header badge -->
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-cyan-500/10 border border-cyan-400/30 text-cyan-600 dark:text-cyan-300 text-[10px] font-black uppercase tracking-widest mb-6">
                <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
                <span>Filosofía de Fabricación</span>
            </div>

            <!-- The Quote -->
            <blockquote class="text-xl sm:text-2xl md:text-3xl font-light text-gray-800 dark:text-gray-200 leading-relaxed mb-8">
                “Todo lo que ves acá nace de la curiosidad y la necesidad. No solo diseño estos periféricos, sino que <span class="text-transparent bg-clip-text bg-gradient-to-r from-fuchsia-500 to-cyan-400 font-bold italic">son exactamente los mismos que uso en mi día a día</span> para trabajar, estudiar ingeniería y competir en simracing.”
            </blockquote>

            <!-- Author signature / bio -->
            <div class="pt-6 border-t border-gray-100 dark:border-white/10 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                <div class="flex items-center gap-4">
                    <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-fuchsia-600 via-indigo-600 to-cyan-500 p-0.5 shadow-md shadow-indigo-500/20">
                        <div class="w-full h-full rounded-[14px] bg-[#0c091e] flex items-center justify-center text-white font-black text-lg">
                            AC
                        </div>
                    </div>
                    <div>
                        <h4 class="text-base font-black text-gray-900 dark:text-white uppercase tracking-tight">Antares Cabrera</h4>
                        <p class="text-xs text-gray-500 dark:text-gray-400 font-light">Estudiante de Ingeniería en Informática · Creador de AntarTech (AlmaMia3D)</p>
                    </div>
                </div>

                <div class="flex items-center gap-3 text-xs font-bold text-gray-600 dark:text-gray-300">
                    <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-gray-100 dark:bg-white/5 border border-gray-200 dark:border-white/10 text-[11px]">
                        📍 Ciudad Evita, Buenos Aires
                    </span>
                </div>
            </div>

        </div>
    </div>
</section>
