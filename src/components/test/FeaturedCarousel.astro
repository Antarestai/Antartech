---
// src/components/test/FeaturedCarousel.astro
import { Image } from 'astro:assets';

interface Props {
  devices: any[];
}

const { devices } = Astro.props;

// Pick top 4 iconic products: Handbrake, Antaknob, Iflag, and Logitech paddle mod
const targetIds = ['handbrake', 'antaknob', 'iflag', 'logitech-paddle-shifter-mod'];
const featuredList = targetIds
  .map(id => devices.find((d: any) => d.id === id))
  .filter(Boolean);

// If less than 4, fallback to first 4 devices
const items = featuredList.length >= 3 ? featuredList : devices.slice(0, 4);

const formatter = new Intl.NumberFormat('es-AR', {
    style: 'currency',
    currency: 'ARS',
    maximumFractionDigits: 0
});
---

<section class="py-8 bg-[#d5d0c8]/40 dark:bg-[#060318] transition-colors duration-700 relative z-20 border-b border-gray-200/50 dark:border-white/5">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Header badge -->
        <div class="flex items-center justify-between gap-4 mb-5 scroll-reveal">
            <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
                <h3 class="text-xs sm:text-sm font-black uppercase tracking-[0.25em] text-gray-900 dark:text-white">
                    🔥 Destacados del Taller · Disponibles Ahora
                </h3>
            </div>
            <a href="#store" class="text-[11px] font-bold uppercase tracking-wider text-indigo-600 dark:text-cyan-400 hover:underline hidden sm:inline-flex items-center gap-1">
                Ver todos los productos
                <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
        </div>

        <!-- Carousel / Grid: Horizontal swipe on mobile, 4-col on desktop -->
        <div class="flex sm:grid sm:grid-cols-2 lg:grid-cols-4 gap-4 overflow-x-auto snap-x snap-mandatory pb-4 sm:pb-0 scroll-reveal no-scrollbar -mx-4 px-4 sm:mx-0 sm:px-0">
            {items.map((device: any) => (
                <div class="min-w-[270px] sm:min-w-0 snap-start flex-1 group relative flex flex-col rounded-2xl bg-white dark:bg-[#0c091e] border border-gray-200/80 dark:border-white/[0.08] shadow-md hover:shadow-xl hover:border-cyan-400/50 dark:hover:border-cyan-400/40 transition-all duration-500 overflow-hidden hover:-translate-y-1">
                    
                    <!-- Image container -->
                    <div class="h-44 sm:h-48 overflow-hidden relative bg-gray-100 dark:bg-gray-900/50">
                        {device.data.image ? (
                            <Image 
                                src={device.data.image as any} 
                                alt={device.data.title} 
                                width={500} 
                                height={380} 
                                format="webp" 
                                class="w-full h-full object-cover transform transition-transform duration-700 group-hover:scale-110" 
                            />
                        ) : (
                            <div class="w-full h-full flex items-center justify-center text-4xl">🛠️</div>
                        )}

                        <!-- Scarcity / Stock Badge -->
                        <div class="absolute top-2.5 right-2.5 z-10">
                            <span class="px-2 py-0.5 rounded-full text-[9px] font-black uppercase tracking-wider bg-black/70 backdrop-blur-md text-white border border-white/10 flex items-center gap-1">
                                <span class="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse"></span>
                                {device.id === 'handbrake' ? 'Últimas 2 unid.' : device.id === 'antaknob' ? 'Tirada limitada' : 'En stock'}
                            </span>
                        </div>

                        <!-- Category micro pill -->
                        <div class="absolute bottom-2.5 left-2.5 z-10">
                            <span class="px-2 py-0.5 rounded-md text-[9px] font-bold uppercase tracking-wider bg-indigo-950/80 backdrop-blur-md text-cyan-300 border border-cyan-400/30">
                                {device.data.category || 'Custom'}
                            </span>
                        </div>
                    </div>

                    <!-- Content -->
                    <div class="p-4 flex flex-col flex-grow justify-between">
                        <div>
                            <h4 class="text-base font-black text-gray-900 dark:text-white uppercase tracking-tight line-clamp-1 mb-1 group-hover:text-cyan-400 transition-colors">
                                {device.data.title}
                            </h4>
                            
                            <!-- Price BIG & Visible -->
                            <div class="my-2 flex items-baseline gap-1.5">
                                <span class="text-xl sm:text-2xl font-black text-gray-900 dark:text-white tracking-tight">
                                    {device.data.price ? formatter.format(device.data.price) : 'Consultar'}
                                </span>
                                <span class="text-[10px] font-bold text-gray-500 uppercase tracking-wider">ARS</span>
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="mt-3 pt-3 border-t border-gray-100 dark:border-white/5 flex items-center gap-2">
                            <a 
                                href={`/devices/${device.id}`}
                                class="flex-grow py-2 rounded-xl text-center text-xs font-black uppercase tracking-wider bg-gray-900 hover:bg-gradient-to-r hover:from-fuchsia-600 hover:to-indigo-600 text-white dark:bg-white dark:text-gray-900 dark:hover:text-white transition-all duration-300 shadow-sm"
                            >
                                Ver Detalle
                            </a>
                            
                            {device.data.price && (
                                <button 
                                    class="add-to-cart-btn p-2 rounded-xl bg-cyan-500/10 hover:bg-cyan-500 text-cyan-600 dark:text-cyan-400 hover:text-white dark:hover:text-gray-900 border border-cyan-500/30 transition-colors shrink-0"
                                    data-id={device.id}
                                    data-title={device.data.title}
                                    data-price={device.data.price}
                                    data-image={typeof device.data.image === 'object' ? device.data.image.src : device.data.image || ''}
                                    title="Añadir al carrito"
                                    aria-label={`Añadir ${device.data.title} al carrito`}
                                >
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
                                        <path d="M3 6h18"/>
                                        <path d="M12 10v6"/>
                                        <path d="M9 13h6"/>
                                    </svg>
                                </button>
                            )}
                        </div>
                    </div>

                </div>
            ))}
        </div>
    </div>
</section>

<style>
    /* Hide scrollbar on mobile while preserving swipeability */
    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }
    .no-scrollbar {
        -ms-overflow-style: none;
        scrollbar-width: none;
    }
</style>
