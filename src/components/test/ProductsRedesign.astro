---
// src/components/test/ProductsRedesign.astro
import { Image } from 'astro:assets';

const { featuredDevices } = Astro.props;

const formatter = new Intl.NumberFormat('es-AR', {
    style: 'currency',
    currency: 'ARS',
    maximumFractionDigits: 0
});

// Helper for scarcity stock text
function getStockBadge(id: string, defaultStock: string) {
    if (id === 'handbrake') return { text: 'Últimas 2 unid. en taller', color: 'bg-amber-500/20 text-amber-700 dark:text-amber-400 border-amber-500/30' };
    if (id === 'antaknob') return { text: 'Lote boutique: 3 disponibles', color: 'bg-green-500/20 text-green-700 dark:text-green-400 border-green-500/30' };
    if (id === 'iflag') return { text: 'En stock · Despacho inmediato', color: 'bg-cyan-500/20 text-cyan-700 dark:text-cyan-400 border-cyan-500/30' };
    if (id === 'logitech-paddle-shifter-mod') return { text: 'En stock · Entrega 24hs', color: 'bg-green-500/20 text-green-700 dark:text-green-400 border-green-500/30' };
    if (defaultStock === 'A Pedido') return { text: 'A Pedido · 3-5 días', color: 'bg-yellow-500/20 text-yellow-700 dark:text-yellow-400 border-yellow-500/30' };
    return { text: defaultStock || 'En Stock', color: 'bg-green-500/20 text-green-700 dark:text-green-400 border-green-500/30' };
}
---

<section id="store" class="py-20 bg-white dark:bg-[#030014] transition-colors duration-700 relative z-20 overflow-hidden">
    <div class="absolute top-0 inset-x-0 h-px bg-gradient-to-r from-transparent via-indigo-500/50 to-transparent"></div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Section Title and Category Filters -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-12 scroll-reveal">
            <div class="flex items-center">
                <h2 class="text-3xl font-black text-gray-900 dark:text-white mr-6 uppercase tracking-tighter">Catálogo de Productos</h2>
                <div class="h-px bg-gradient-to-r from-indigo-500/50 to-transparent w-24 hidden lg:block"></div>
            </div>

            <!-- Category Filters -->
            <div class="flex flex-wrap items-center gap-2" id="category-filters">
                <button 
                    type="button" 
                    data-filter="all" 
                    class="category-filter-btn px-5 py-2.5 rounded-2xl text-xs font-black uppercase tracking-wider transition-all duration-300 bg-gray-900 text-white dark:bg-white dark:text-gray-900 shadow-md shadow-indigo-500/10 cursor-pointer"
                >
                    Todos
                </button>
                <button 
                    type="button" 
                    data-filter="simracing" 
                    class="category-filter-btn px-5 py-2.5 rounded-2xl text-xs font-black uppercase tracking-wider transition-all duration-300 bg-gray-100 dark:bg-white/[0.04] text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white border border-gray-200/80 dark:border-white/[0.08] cursor-pointer"
                >
                    🏎️ SimRacing
                </button>
                <button 
                    type="button" 
                    data-filter="logitech" 
                    class="category-filter-btn px-5 py-2.5 rounded-2xl text-xs font-black uppercase tracking-wider transition-all duration-300 bg-gray-100 dark:bg-white/[0.04] text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white border border-gray-200/80 dark:border-white/[0.08] cursor-pointer"
                >
                    🎮 Accesorios Logitech
                </button>
                <button 
                    type="button" 
                    data-filter="productividad" 
                    class="category-filter-btn px-5 py-2.5 rounded-2xl text-xs font-black uppercase tracking-wider transition-all duration-300 bg-gray-100 dark:bg-white/[0.04] text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white border border-gray-200/80 dark:border-white/[0.08] cursor-pointer"
                >
                    ⌨️ Productividad & Control
                </button>
            </div>
        </div>
        
        <!-- Products Grid -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="products-grid">
            {featuredDevices.map((device: any, index: number) => {
                const deviceCats = [
                    device.data.category?.toLowerCase() || '',
                    ...(device.data.tags || []).map((t: string) => t.toLowerCase()),
                    device.id.toLowerCase()
                ].join(' ');

                const stockInfo = getStockBadge(device.id, device.data.stock);
                const waMessage = `Hola, me comunico para consultar por el ${device.data.title}`;
                const waLink = `https://wa.me/541165361612?text=${encodeURIComponent(waMessage)}`;

                return (
                <div 
                    class={`product-card group relative bg-white dark:bg-[#0c091e] border border-gray-200/80 dark:border-white/[0.08] rounded-[2rem] overflow-hidden shadow-lg hover:shadow-2xl hover:border-indigo-400/50 dark:hover:border-cyan-400/40 transition-all duration-500 flex flex-col scroll-reveal hover:-translate-y-2 ${device.data.isAccessory ? 'is-accessory hidden' : ''}`} 
                    style={`transition-delay: ${index * 60}ms`}
                    data-category={deviceCats}
                    data-is-accessory={device.data.isAccessory ? "true" : "false"}
                >
                    <!-- Image container -->
                    <div class="h-64 overflow-hidden relative z-10 bg-gray-100 dark:bg-gray-900/50">
                        {device.data.image ? (
                            <Image 
                                src={device.data.image as any} 
                                alt={device.data.title} 
                                width={800} 
                                height={600} 
                                format="webp" 
                                class="w-full h-full object-cover transform transition-transform duration-700 group-hover:scale-105 will-change-transform" 
                            />
                        ) : (
                            <div class="w-full h-full flex items-center justify-center text-7xl bg-gray-200 dark:bg-gray-800">🛠️</div>
                        )}
                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                        
                        <!-- Stock Scarcity Badge (Top Right) -->
                        <div class="absolute top-3.5 right-3.5 z-20">
                            <span class={`px-3 py-1 rounded-full text-[9px] font-black uppercase tracking-wider border shadow-md flex items-center gap-1.5 backdrop-blur-md bg-black/60 text-white ${stockInfo.color}`}>
                                <span class="w-1.5 h-1.5 rounded-full bg-green-400 animate-pulse"></span>
                                {stockInfo.text}
                            </span>
                        </div>

                        <!-- Price Tag Overlay (Top Left) for instant Above-the-fold visibility -->
                        {device.data.price && (
                            <div class="absolute top-3.5 left-3.5 z-20">
                                <span class="px-3 py-1 rounded-xl text-xs font-black bg-gray-950/80 backdrop-blur-md text-white border border-white/20 shadow-md">
                                    {formatter.format(device.data.price)}
                                </span>
                            </div>
                        )}
                    </div>

                    <!-- Card Body -->
                    <div class="p-6 sm:p-7 flex flex-col flex-grow relative z-10">
                        
                        <!-- Subtle micro-tags (low visual hierarchy to let Title dominate) -->
                        <div class="flex flex-wrap gap-1.5 mb-2.5">
                            {device.data.category && (
                                <span class="text-[9px] font-bold uppercase tracking-wider text-cyan-600 dark:text-cyan-400 bg-cyan-50 dark:bg-cyan-950/50 px-2 py-0.5 rounded border border-cyan-200/60 dark:border-cyan-800/40">
                                    {device.data.category}
                                </span>
                            )}
                            {device.data.tags && device.data.tags.slice(0, 3).map((tag: string) => (
                                <span class="text-[9px] font-medium uppercase tracking-wider text-gray-500 dark:text-gray-400 bg-gray-100 dark:bg-white/[0.03] px-2 py-0.5 rounded border border-gray-200/60 dark:border-white/5">
                                    {tag}
                                </span>
                            ))}
                        </div>

                        <!-- Product Title -->
                        <h3 class="text-xl sm:text-2xl font-black text-gray-900 dark:text-white mb-2 uppercase tracking-tight leading-tight group-hover:text-indigo-600 dark:group-hover:text-cyan-400 transition-colors duration-300">
                            {device.data.title}
                        </h3>

                        <!-- Short Description -->
                        <p class="text-gray-600 dark:text-gray-400 text-xs sm:text-sm mb-5 leading-relaxed font-light line-clamp-2">
                            {device.data.description}
                        </p>

                        <!-- Price Highlight (Big & Clear) -->
                        <div class="mb-5 pb-4 border-b border-gray-100 dark:border-white/5 flex items-baseline justify-between">
                            <span class="text-xs font-bold uppercase tracking-wider text-gray-500">Precio Oficial:</span>
                            <div class="flex items-baseline gap-1">
                                <span class="text-2xl sm:text-3xl font-black text-gray-900 dark:text-white tracking-tight">
                                    {device.data.price ? formatter.format(device.data.price) : 'A Consultar'}
                                </span>
                                <span class="text-[10px] font-bold text-gray-400 uppercase">ARS</span>
                            </div>
                        </div>
                        
                        <!-- CTAs and Action Buttons -->
                        <div class="mt-auto space-y-2.5">
                            <!-- Primary Action: Setup/Details & Add to Cart -->
                            <div class="flex items-center gap-2">
                                <a 
                                    href={`/devices/${device.id}`} 
                                    class="flex-grow flex justify-center items-center bg-gray-900 dark:bg-white text-white dark:text-gray-900 py-3 rounded-xl font-black uppercase text-xs tracking-wider transition-all duration-300 hover:bg-gradient-to-r hover:from-fuchsia-600 hover:to-indigo-600 dark:hover:from-fuchsia-500 dark:hover:to-cyan-500 dark:hover:text-white shadow-md hover:shadow-indigo-500/25"
                                >
                                    Ver Ficha Técnica
                                </a>

                                {device.data.price && (
                                    <button 
                                        class="add-to-cart-btn flex items-center justify-center w-11 h-11 bg-indigo-50 dark:bg-indigo-500/10 border border-indigo-200 dark:border-indigo-500/30 rounded-xl hover:bg-indigo-600 hover:border-indigo-600 dark:hover:bg-cyan-500 dark:hover:border-cyan-500 text-indigo-600 hover:text-white dark:text-cyan-400 dark:hover:text-gray-900 transition-all duration-300 shrink-0 shadow-sm group/cart"
                                        data-id={device.id}
                                        data-title={device.data.title}
                                        data-price={device.data.price} 
                                        data-image={typeof device.data.image === 'object' ? device.data.image.src : device.data.image || ''}
                                        aria-label={`Añadir ${device.data.title} al carrito`}
                                        title="Añadir al carrito"
                                    >
                                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" class="group-hover/cart:scale-110 transition-transform duration-300" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/>
                                            <path d="M3 6h18"/>
                                            <path d="M12 10v6"/>
                                            <path d="M9 13h6"/>
                                        </svg>
                                    </button>
                                )}
                            </div>

                            <!-- Secondary Explicit CTA: Mercado Libre or WhatsApp -->
                            {device.data.mercadolibreUrl ? (
                                <a 
                                    href={device.data.mercadolibreUrl} 
                                    target="_blank" 
                                    rel="noopener noreferrer" 
                                    class="w-full flex items-center justify-center gap-2 py-2.5 rounded-xl text-[11px] font-bold uppercase tracking-wider bg-yellow-400/10 hover:bg-yellow-400/20 text-yellow-700 dark:text-yellow-400 border border-yellow-400/30 transition-all duration-300 hover:border-yellow-400/60"
                                >
                                    <img src="/images/mercadolibre.png" alt="Mercado Libre" class="w-3.5 h-3.5 object-contain" />
                                    <span>Comprar en Mercado Libre Oficial</span>
                                </a>
                            ) : (
                                <a 
                                    href={waLink} 
                                    target="_blank" 
                                    rel="noopener noreferrer" 
                                    class="w-full flex items-center justify-center gap-2 py-2.5 rounded-xl text-[11px] font-bold uppercase tracking-wider bg-green-500/10 hover:bg-green-500/20 text-green-700 dark:text-green-400 border border-green-500/30 transition-all duration-300 hover:border-green-500/60"
                                >
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 21l1.65-3.8a9 9 0 1 1 3.4 2.9L3 21"/><path d="M9 10a.5.5 0 0 0 1 0V9a.5.5 0 0 0-1 0v1a5 5 0 0 0 5 5h1a.5.5 0 0 0 0-1h-1a.5.5 0 0 0 0 1"/></svg>
                                    <span>Consultar Disponibilidad por WhatsApp</span>
                                </a>
                            )}
                        </div>

                    </div>
                </div>
                );
            })}

            <!-- Tarjeta Ecosistema / Accesorios Logitech G -->
            <div 
                id="logitech-hub-card"
                class="product-card group relative bg-white dark:bg-[#0c091e] border-2 border-cyan-500/40 hover:border-cyan-400 dark:border-cyan-500/30 dark:hover:border-cyan-400 rounded-[2rem] overflow-hidden shadow-lg shadow-cyan-500/10 dark:shadow-cyan-950/40 transition-all duration-500 hover:-translate-y-2 flex flex-col scroll-reveal cursor-pointer"
                data-category="all simracing"
            >
                <div class="h-64 relative overflow-hidden bg-gradient-to-b from-cyan-950/30 via-slate-900 to-slate-950 flex items-center justify-center p-6">
                    <div class="absolute inset-0 bg-[radial-gradient(#06b6d4_1px,transparent_1px)] [background-size:16px_16px] opacity-25"></div>
                    <div class="absolute inset-0 bg-gradient-to-t from-white dark:from-[#0c091e] via-transparent to-transparent"></div>

                    <!-- Hub Emblem -->
                    <div class="relative z-10 flex flex-col items-center text-center space-y-2">
                        <div class="w-20 h-20 rounded-2xl bg-cyan-500/10 border border-cyan-400/40 flex items-center justify-center shadow-lg shadow-cyan-500/20 group-hover:scale-110 group-hover:border-cyan-300 transition-transform duration-500">
                            <span class="text-4xl font-black text-transparent bg-clip-text bg-gradient-to-br from-cyan-300 via-blue-400 to-indigo-400 font-mono tracking-tighter">G</span>
                        </div>
                        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-cyan-500/20 border border-cyan-400/30 text-[9px] font-black uppercase tracking-widest text-cyan-300">
                            <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
                            Ecosistema Logitech G
                        </div>
                    </div>

                    <div class="absolute top-3.5 right-3.5 z-20">
                        <span class="px-2.5 py-1 rounded-full text-[9px] font-black uppercase tracking-widest bg-cyan-500/15 text-cyan-300 border border-cyan-400/30">
                            G29 · G920 · G923
                        </span>
                    </div>
                </div>

                <div class="p-6 sm:p-7 flex flex-col flex-grow relative z-10">
                    <div class="flex flex-wrap gap-1.5 mb-2.5">
                        <span class="text-[9px] font-bold uppercase tracking-wider text-cyan-700 dark:text-cyan-300 bg-cyan-100/90 dark:bg-cyan-950/80 px-2 py-0.5 rounded border border-cyan-300 dark:border-cyan-700/60 shadow-sm">
                            Accesorios & Mods
                        </span>
                    </div>

                    <h3 class="text-xl sm:text-2xl font-black text-gray-900 dark:text-white mb-2 uppercase tracking-tight leading-tight group-hover:text-cyan-400 transition-colors">
                        Accesorios para Logitech
                    </h3>
                    <p class="text-gray-600 dark:text-gray-400 text-xs sm:text-sm mb-6 leading-relaxed font-light">
                        Interfaces de pedalera independientes de 12 bits y mods de levas magnéticas de alto impacto.
                    </p>

                    <div class="mt-auto pt-4 border-t border-gray-100 dark:border-white/5 flex items-center justify-between">
                        <span class="text-xs font-black uppercase tracking-wider text-cyan-600 dark:text-cyan-400">Ver accesorios compatibles</span>
                        <div class="w-10 h-10 rounded-xl bg-cyan-500/10 group-hover:bg-cyan-500 text-cyan-600 dark:text-cyan-400 group-hover:text-white dark:group-hover:text-gray-900 flex items-center justify-center transition-all duration-300 transform group-hover:translate-x-1 shadow-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Tarjeta Nuevos Proyectos -->
            <div 
                class="product-card group relative bg-indigo-50/50 dark:bg-[#0c091e] border-2 border-dashed border-indigo-200 dark:border-white/10 rounded-[2rem] overflow-hidden transition-all duration-500 hover:-translate-y-2 flex flex-col scroll-reveal" 
                data-category="all productividad setup"
            >
                <div class="h-64 flex items-center justify-center bg-gray-50/50 dark:bg-white/[0.02] relative overflow-hidden">
                    <div class="text-center space-y-3">
                        <div class="w-16 h-16 mx-auto rounded-2xl bg-white dark:bg-white/10 shadow-lg flex items-center justify-center transform group-hover:rotate-12 transition-transform duration-500">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 text-indigo-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12 3v18M3 12h18"/>
                            </svg>
                        </div>
                        <p class="text-[10px] font-black uppercase tracking-[0.2em] text-indigo-500 dark:text-indigo-400">En Taller</p>
                    </div>
                </div>
                <div class="p-6 sm:p-7 flex flex-col flex-grow text-center">
                    <h3 class="text-xl sm:text-2xl font-black text-gray-900 dark:text-white mb-2 uppercase tracking-tight">Nuevos Desarrollos</h3>
                    <p class="text-gray-600 dark:text-gray-400 text-xs sm:text-sm mb-6 leading-relaxed font-light">Diseñamos constantemente nuevos periféricos a pedido de la comunidad.</p>
                    <div class="mt-auto">
                        <a href="#contact" class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-wider text-indigo-600 dark:text-cyan-400 group/link">
                            Sugerir un periférico
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transform group-hover/link:translate-x-1 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<script>
    import { cartStore } from '../../scripts/cartStore.js';

    document.addEventListener('DOMContentLoaded', () => {
        const filterButtons = document.querySelectorAll('.category-filter-btn');
        const productCards = document.querySelectorAll('.product-card');
        const logitechHubCard = document.getElementById('logitech-hub-card');

        function setCategoryFilter(filter: string) {
            filterButtons.forEach(b => {
                const btnFilter = b.getAttribute('data-filter');
                if (btnFilter === filter) {
                    b.classList.add('active', 'bg-gray-900', 'text-white', 'dark:bg-white', 'dark:text-gray-900', 'shadow-md');
                    b.classList.remove('bg-gray-100', 'dark:bg-white/[0.04]', 'text-gray-600', 'dark:text-gray-400', 'border', 'border-gray-200/80', 'dark:border-white/[0.08]');
                } else {
                    b.classList.remove('active', 'bg-gray-900', 'text-white', 'dark:bg-white', 'dark:text-gray-900', 'shadow-md');
                    b.classList.add('bg-gray-100', 'dark:bg-white/[0.04]', 'text-gray-600', 'dark:text-gray-400', 'border', 'border-gray-200/80', 'dark:border-white/[0.08]');
                }
            });

            productCards.forEach((card: any) => {
                if (card.id === 'logitech-hub-card') {
                    if (filter === 'all' || filter === 'simracing') {
                        card.style.display = 'flex';
                    } else {
                        card.style.display = 'none';
                    }
                    return;
                }

                const isAccessory = card.dataset.isAccessory === 'true';
                const cats = (card.dataset.category || '').toLowerCase();

                if (filter === 'all') {
                    if (isAccessory) {
                        card.style.display = 'none';
                    } else {
                        card.style.display = 'flex';
                    }
                } else if (filter === 'logitech') {
                    if (cats.includes('logitech')) {
                        card.style.display = 'flex';
                    } else {
                        card.style.display = 'none';
                    }
                } else {
                    if (cats.includes(filter)) {
                        card.style.display = 'flex';
                    } else {
                        card.style.display = 'none';
                    }
                }
            });
        }

        filterButtons.forEach(btn => {
            btn.addEventListener('click', () => {
                const filter = btn.getAttribute('data-filter') || 'all';
                setCategoryFilter(filter);
            });
        });

        // Listen for category filter events dispatched by interactive marquee ticker
        window.addEventListener('antares_apply_category_filter', (e: any) => {
            const cat = e.detail?.category || 'all';
            setCategoryFilter(cat);
        });

        if (logitechHubCard) {
            logitechHubCard.addEventListener('click', () => {
                setCategoryFilter('logitech');
                const storeEl = document.getElementById('store');
                if (storeEl) {
                    storeEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
                }
            });
        }

        // Cart store logic
        const addButtons = document.querySelectorAll('.add-to-cart-btn');
        addButtons.forEach(btn => {
            btn.addEventListener('click', (e) => {
                const button = e.currentTarget as HTMLElement;
                const id = button.dataset.id;
                const title = button.dataset.title;
                const price = parseFloat(button.dataset.price || '0');
                const image = button.dataset.image;

                if (id && title) {
                    const originalHTML = button.innerHTML;
                    button.innerHTML = `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="animate-bounce"><polyline points="20 6 9 17 4 12"></polyline></svg>`;
                    button.classList.add('bg-green-500', 'text-white', 'border-green-500');
                    button.classList.remove('text-indigo-600', 'text-cyan-400');
                    
                    setTimeout(() => {
                        button.innerHTML = originalHTML;
                        button.classList.remove('bg-green-500', 'text-white', 'border-green-500');
                        button.classList.add('text-indigo-600', 'text-cyan-400');
                    }, 1000);

                    cartStore.addItem({ id, title, price, image });
                    window.dispatchEvent(new CustomEvent('antares_open_cart'));
                }
            });
        });
    });
</script>
