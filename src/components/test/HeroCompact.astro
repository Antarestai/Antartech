---
// src/components/test/HeroCompact.astro
---

<section id="hero-section" class="relative overflow-hidden bg-[#d5d0c8] dark:bg-[#030014] transition-colors duration-700 pt-24 pb-8 sm:pt-28 sm:pb-12 border-b border-gray-200/40 dark:border-white/5">
    <!-- Background Layer with PCB Lines and Ambient Glow -->
    <div id="hero-bg" class="absolute inset-0 pointer-events-none">
        <div class="absolute inset-0 opacity-[0.25] dark:opacity-[0.7] transition-opacity duration-700" 
            style="background: 
                linear-gradient(135deg, var(--pcb-line) 2px, transparent 2px),
                linear-gradient(225deg, var(--pcb-line) 2px, transparent 2px),
                radial-gradient(var(--pcb-pad) 4px, transparent 4px);
                background-size: 60px 60px, 60px 60px, 60px 60px;
                background-position: 0 0, 30px 0, 30px 30px;
                background-color: var(--pcb-bg);"
        ></div>
        
        <div class="absolute inset-0 bg-gradient-to-b from-[#d5d0c8]/40 via-[#d5d0c8]/80 to-[#d5d0c8] dark:from-transparent dark:via-[#030014]/60 dark:to-[#030014] transition-colors duration-700"></div>
        
        <div class="absolute inset-0" style="background: radial-gradient(circle at 85% 15%, rgba(217, 70, 239, 0.12), transparent 45%), radial-gradient(circle at 15% 85%, rgba(6, 182, 212, 0.12), transparent 45%), radial-gradient(circle at 50% 50%, rgba(99, 102, 241, 0.08), transparent 60%);"></div>
    </div>

    <!-- Main Compact Content (Above-the-fold targeted) -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 items-center">
            
            <!-- Left: Hero Headline & Value proposition -->
            <div class="lg:col-span-8 scroll-reveal">
                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-fuchsia-500/10 dark:bg-fuchsia-500/15 border border-fuchsia-500/30 text-fuchsia-600 dark:text-fuchsia-400 text-[10px] font-black uppercase tracking-widest mb-3">
                    <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
                    <span>Taller Boutique · Tiradas Limitadas en Bs As</span>
                </div>
                
                <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black tracking-tighter text-gray-900 dark:text-white leading-[0.95] uppercase mb-4">
                    Periféricos <br/> 
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-fuchsia-500 via-indigo-500 to-cyan-500 dark:from-fuchsia-400 dark:via-indigo-400 dark:to-cyan-400 italic">Custom & SimRacing.</span>
                </h1>

                <p class="text-sm sm:text-base text-gray-700 dark:text-gray-300 font-light leading-relaxed max-w-2xl mb-6">
                    Frenos de mano de alta precisión, adaptadores hápticos e interfaces rotativas macro. Diseñados con microcontroladores RP2040 y ensamblados a mano para máxima fidelidad y respuesta sin retraso.
                </p>

                <!-- Quick actions & Trust Badges -->
                <div class="flex flex-wrap items-center gap-4 text-xs font-semibold">
                    <a 
                        href="#store" 
                        class="px-6 py-3 rounded-2xl bg-gradient-to-r from-fuchsia-600 via-indigo-600 to-cyan-600 text-white font-black uppercase text-xs tracking-wider shadow-lg shadow-indigo-500/25 hover:shadow-indigo-500/40 hover:scale-[1.02] transition-all duration-300 flex items-center gap-2"
                    >
                        <span>Ver Productos</span>
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
                    </a>

                    <div class="flex items-center gap-3 text-gray-600 dark:text-gray-400 text-[11px] sm:text-xs">
                        <span class="flex items-center gap-1">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-green-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                            Plug & Play
                        </span>
                        <span>·</span>
                        <span class="flex items-center gap-1">
                            <svg xmlns="http://www.w3.org/2000/svg" class="w-3.5 h-3.5 text-green-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"/></svg>
                            Envíos a todo el país
                        </span>
                    </div>
                </div>
            </div>

            <!-- Right: Maker Mini Badge -->
            <div class="lg:col-span-4 border-l-2 border-indigo-600/30 pl-6 py-2 scroll-reveal hidden sm:block">
                <div class="flex items-center gap-2 mb-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-indigo-500 dark:text-cyan-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                    <p class="text-[10px] font-black uppercase tracking-[0.3em] text-indigo-500 dark:text-cyan-400">Maker & Developer</p>
                </div>
                <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-1 flex items-center gap-2.5">
                    Antares Cabrera. 
                    <span class="inline-flex items-center gap-1 text-[9px] font-bold uppercase tracking-widest text-green-600 dark:text-green-400 bg-green-50 dark:bg-green-500/10 px-2 py-0.5 rounded-full border border-green-200/50 dark:border-green-500/20">
                        <span class="w-1.5 h-1.5 rounded-full bg-green-500 animate-pulse"></span>Taller Activo
                    </span>
                </h2>
                <p class="text-xs text-gray-600 dark:text-gray-400 font-light leading-relaxed">
                    Estudiante de Ingeniería en Informática. Cada pieza es diseñada, fabricada y calibrada artesanalmente para rendimiento exigente.
                </p>
            </div>
        </div>
    </div>
</section>
